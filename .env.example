# ============================================================================
# Signal Archive Environment Configuration Template
# ============================================================================
# Copy this file to `.env` or `.env.local` for local development.
# DO NOT commit real secrets or production credentials to source control.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL 17 + pgvector)
# ----------------------------------------------------------------------------
# Production / Staging: Neon Serverless Postgres (ADR-0011, DATABASE.md)
#   DATABASE_URL: Pooled connection for runtime API & worker queries (e.g., -pooler host)
#   DATABASE_URL_DIRECT: Direct connection for Drizzle Kit schema migrations
#
# DATABASE_URL=postgresql://<user>:<password>@<neon-pooled-host>/<database>?sslmode=require
# DATABASE_URL_DIRECT=postgresql://<user>:<password>@<neon-direct-host>/<database>?sslmode=require

# Local Docker Fallback (FND-004, OPS-001):
# Used when running local Docker Compose stack (`docker compose --profile stack up -d`)
DATABASE_URL=postgresql://techpulse_dev_unsafe:unsafe-local-development-only@localhost:5432/techpulse_dev
DATABASE_URL_DIRECT=postgresql://techpulse_dev_unsafe:unsafe-local-development-only@localhost:5432/techpulse_dev

# Optional local overrides for Docker Compose postgres service:
# TECHPULSE_DEV_POSTGRES_DB=techpulse_dev
# TECHPULSE_DEV_POSTGRES_USER=techpulse_dev_unsafe
# TECHPULSE_DEV_POSTGRES_PASSWORD=unsafe-local-development-only

# ----------------------------------------------------------------------------
# 2. Redis Queue Configuration (Redis 7.4)
# ----------------------------------------------------------------------------
# Required for worker queue and concurrency limiter (BullMQ / ioredis)
REDIS_URL=redis://localhost:6379

# ----------------------------------------------------------------------------
# 3. AI / LLM Chat Provider (OpenAI-compatible, RunInfra)
# ----------------------------------------------------------------------------
# Used by @techpulse/rag and @techpulse/api for natural language answers
OPENAI_BASE_URL=https://api.runinfra.ai/v1
OPENAI_CHAT_MODEL=deepseek-v4-flash
OPENAI_API_KEY=<runinfra-api-key>

# ----------------------------------------------------------------------------
# 4. AI / Embedding Provider (OpenRouter / Perplexity Embeddings)
# ----------------------------------------------------------------------------
# Used by @techpulse/rag for document/query embedding vectors
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=perplexity/pplx-embed-v1-0.6b
EMBEDDING_DIMENSIONS=1024
EMBEDDING_API_KEY=<openrouter-api-key>

# ----------------------------------------------------------------------------
# 5. External Data Source Credentials (DISC-002, SECURITY.md §7)
# ----------------------------------------------------------------------------
# Required for collector workers to fetch data without restrictive rate limits
GITHUB_PAT=ghp_...
STACK_EXCHANGE_KEY=<key>
HUGGINGFACE_TOKEN=hf_...

# ----------------------------------------------------------------------------
# 6. Service Ports & Runtime Controls
# ----------------------------------------------------------------------------
# API HTTP Port (default: 3000)
PORT=3000

# Worker Concurrency Limit (default: 1, range: 1..100)
WORKER_CONCURRENCY=2

# CORS Allowed Origins for API (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# API Rate Limiting & Abuse Controls
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=100
API_MAX_CONCURRENT_ANSWERS=10
API_MAX_DAILY_ANSWER_BUDGET=1000

# Web UI Origin
WEB_ORIGIN=http://localhost:5173
