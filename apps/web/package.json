{
  "name": "@techpulse/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && vite build",
    "format": "pnpm --dir ../.. exec prettier --check apps/web",
    "lint": "eslint .",
    "static": "pnpm run typecheck && pnpm run lint && pnpm run format",
    "test": "vitest run",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@techpulse/contracts": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^6.1.0",
    "@sveltejs/kit": "^2.48.4",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "svelte": "^5.39.6",
    "vite": "^7.1.7"
  }
}
