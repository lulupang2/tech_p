{
  "name": "@techpulse/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "format": "pnpm --dir ../.. exec prettier --check apps/api",
    "lint": "eslint .",
    "start": "node --env-file=.env --import=tsx/esm src/index.ts",
    "static": "pnpm run typecheck && pnpm run lint && pnpm run format",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elysiajs/node": "^1.4.0",
    "@techpulse/observability": "workspace:*",
    "elysia": "^1.4.0"
  },
  "devDependencies": {
    "tsx": "^4.20.5"
  }
}
