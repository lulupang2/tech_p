# Required Neon PostgreSQL pooled runtime URL
DATABASE_URL=postgresql://<user>:<password>@<pooled-host>/<database>?sslmode=require

# Optional direct Neon URL for Drizzle Kit migrations
DATABASE_URL_DIRECT=postgresql://<user>:<password>@<direct-host>/<database>?sslmode=require

# Source collector credentials — placeholder names only; real values injected at deploy time (SECURITY.md §7, §11)
# DISC-002 requires these before COL-001 collector implementation.
# Actual values must not be committed (AGENTS.md §8, SECURITY.md §5, THR-005)
GITHUB_PAT=ghp_...
STACK_EXCHANGE_KEY=<key>
STACK_EXCHANGE_ACCESS_TOKEN=<access_token>
HUGGINGFACE_TOKEN=hf_...

# Optional HTTP listen port (default: 3000)
PORT=<port>
